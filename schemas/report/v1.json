{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wavemaker.dev/schemas/report/v1.json",
  "title": "Wavemaker Swell Report v1",
  "description": "Data exchange format for Wavemaker Swell reports. Structure follows plan document section 13.2 (14 report sections) plus the optional §15 assertions section introduced by ADR-007; conclusion constraints follow section 13.3 and are enforced at field level via if/then rules. Data quality labels follow plan section 11.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "swell_id",
    "generated_at",
    "overall_data_quality",
    "sections",
    "conclusions"
  ],
  "properties": {
    "schema_version": { "const": "wavemaker.report/v1" },
    "swell_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "overall_data_quality": { "$ref": "#/$defs/data_quality" },
    "sections": { "$ref": "#/$defs/sections" },
    "conclusions": { "$ref": "#/$defs/conclusions" }
  },
  "allOf": [
    {
      "$comment": "R1 (plan 13.3): generator saturated -> no server capacity conclusion.",
      "if": {
        "properties": {
          "sections": {
            "properties": {
              "generator_health": {
                "properties": {
                  "saturation": {
                    "properties": { "flag": { "const": true } },
                    "required": ["flag"]
                  }
                }
              }
            },
            "required": ["generator_health"]
          }
        }
      },
      "then": {
        "properties": {
          "conclusions": { "properties": { "capacity_conclusion": { "type": "null" } } }
        }
      }
    },
    {
      "$comment": "R1b: overall GeneratorSaturated -> no server capacity conclusion.",
      "if": {
        "properties": { "overall_data_quality": { "const": "GeneratorSaturated" } }
      },
      "then": {
        "properties": {
          "conclusions": { "properties": { "capacity_conclusion": { "type": "null" } } }
        }
      }
    },
    {
      "$comment": "R2 (plan 13.3): a capacity conclusion must be grounded in Basin server metrics, never client latency alone.",
      "if": {
        "properties": {
          "conclusions": {
            "properties": { "capacity_conclusion": { "type": "object" } },
            "required": ["capacity_conclusion"]
          }
        }
      },
      "then": {
        "properties": {
          "sections": {
            "properties": {
              "server_performance": {
                "properties": {
                  "quality": { "enum": ["Complete", "Partial", "Delayed", "Estimated"] },
                  "sources": { "contains": { "const": "Basin" } }
                },
                "required": ["quality", "sources"]
              }
            },
            "required": ["server_performance"]
          }
        }
      }
    },
    {
      "$comment": "R3 (plan 13.3): insufficient observability coverage -> confidence must drop to low.",
      "if": {
        "properties": {
          "sections": {
            "properties": {
              "server_performance": {
                "properties": {
                  "quality": {
                    "enum": ["Partial", "Delayed", "Missing", "Invalid", "ObserverDegraded"]
                  }
                },
                "required": ["quality"]
              }
            },
            "required": ["server_performance"]
          }
        }
      },
      "then": {
        "properties": {
          "conclusions": { "properties": { "confidence": { "const": "low" } } }
        }
      }
    },
    {
      "$comment": "R5 (ADR-007): a failed business assertion degrades test validity — the report may never stay 'Valid' when an assertion provider reported a semantic violation.",
      "if": {
        "properties": {
          "sections": {
            "properties": {
              "assertions": {
                "properties": {
                  "results": {
                    "contains": {
                      "properties": { "status": { "const": "fail" } },
                      "required": ["status"]
                    }
                  }
                },
                "required": ["results"]
              }
            },
            "required": ["assertions"]
          }
        }
      },
      "then": {
        "properties": {
          "sections": {
            "properties": {
              "test_validity": {
                "properties": { "verdict": { "enum": ["Invalid", "Partial"] } }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "R4 (plan 13.3 / 4.4): with multiple backends, per-backend grouping is mandatory.",
      "if": {
        "properties": {
          "sections": {
            "properties": {
              "experiment_summary": {
                "properties": { "backend_count": { "type": "integer", "minimum": 2 } },
                "required": ["backend_count"]
              }
            },
            "required": ["experiment_summary"]
          }
        }
      },
      "then": {
        "properties": {
          "sections": {
            "properties": {
              "client_performance": {
                "properties": {
                  "per_backend": { "type": "array", "minItems": 2 }
                },
                "required": ["per_backend"]
              }
            },
            "required": ["client_performance"]
          }
        }
      }
    }
  ],
  "$defs": {
    "data_quality": {
      "description": "Plan 11.3 data quality labels.",
      "enum": [
        "Complete",
        "Partial",
        "Delayed",
        "Missing",
        "Estimated",
        "Invalid",
        "GeneratorSaturated",
        "ObserverDegraded"
      ]
    },
    "data_source": {
      "description": "Origin of the data behind a section. AssertionProvider covers business-semantics assertion results delivered by external providers (ADR-007); it is never a substitute for Basin.",
      "enum": ["Planned", "Actual", "Basin", "Generator", "AssertionProvider"]
    },
    "section_base": {
      "type": "object",
      "required": ["quality", "sources"],
      "properties": {
        "quality": { "$ref": "#/$defs/data_quality" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/data_source" },
          "minItems": 1,
          "uniqueItems": true
        },
        "notes": { "type": "string" }
      }
    },
    "backend_slice": {
      "type": "object",
      "required": ["backend_id", "backend_type", "quality"],
      "properties": {
        "backend_id": { "type": "string", "minLength": 1 },
        "backend_type": { "enum": ["native", "engine_bot"] },
        "quality": { "$ref": "#/$defs/data_quality" },
        "latency_p50_ms": { "type": ["number", "null"] },
        "latency_p95_ms": { "type": ["number", "null"] },
        "latency_p99_ms": { "type": ["number", "null"] },
        "effective_request_rate": { "type": ["number", "null"], "description": "req/s" },
        "cpu_percent": { "type": ["number", "null"], "description": "generator-side CPU, %" },
        "memory_rss_bytes": { "type": ["integer", "null"] },
        "connections": { "type": ["integer", "null"] }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_summary",
        "spectrum_load_profile",
        "planned_vs_actual_arrival",
        "concurrency_curve",
        "client_performance",
        "generator_health",
        "engine_bot_backend_details",
        "server_performance",
        "correlation_analysis",
        "bottleneck_analysis",
        "data_quality",
        "test_validity",
        "environment",
        "raw_data_references"
      ],
      "properties": {
        "experiment_summary": {
          "allOf": [{ "$ref": "#/$defs/section_base" }],
          "properties": {
            "swell_name": { "type": "string" },
            "started_at": { "type": "string", "format": "date-time" },
            "ended_at": { "type": ["string", "null"], "format": "date-time" },
            "backend_count": { "type": "integer", "minimum": 1 }
          }
        },
        "spectrum_load_profile": {
          "allOf": [{ "$ref": "#/$defs/section_base" }],
          "properties": {
            "arrival_model": { "type": "string", "description": "e.g. ramp exponential-growth 1/s -> 20/s over 600s" },
            "lifetime_distribution": { "enum": ["fixed", "exponential", "other"] },
            "lifetime_mean_s": { "type": ["number", "null"] },
            "concurrency_target": { "type": ["integer", "null"] },
            "concurrency_max": { "type": ["integer", "null"] },
            "saturation_policy": { "enum": ["reject_new", "queue", "delay", "none"] }
          }
        },
        "planned_vs_actual_arrival": {
          "allOf": [{ "$ref": "#/$defs/section_base" }],
          "properties": {
            "planned_arrivals": { "type": "integer", "minimum": 0 },
            "actual_arrivals": { "type": ["integer", "null"], "minimum": 0 },
            "rejected_arrivals": { "type": ["integer", "null"], "minimum": 0 },
            "deviation_p50_s": { "type": ["number", "null"] },
            "deviation_p99_s": { "type": ["number", "null"] }
          }
        },
        "concurrency_curve": {
          "allOf": [{ "$ref": "#/$defs/section_base" }],
          "properties": {
            "peak_concurrency": { "type": ["integer", "null"], "minimum": 0 },
            "series_points": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "client_performance": {
          "allOf": [{ "$ref": "#/$defs/section_base" }],
          "properties": {
            "per_backend": { "type": "array", "items": { "$ref": "#/$defs/backend_slice" } }
          }
        },
        "generator_health": {
          "allOf": [{ "$ref": "#/$defs/section_base" }],
          "required": ["saturation"],
          "properties": {
            "saturation": {
              "type": "object",
              "required": ["flag"],
              "properties": {
                "flag": { "type": "boolean" },
                "reason": { "type": "string" }
              }
            },
            "workers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["worker_id"],
                "properties": {
                  "worker_id": { "type": "string", "minLength": 1 },
                  "cpu_percent": { "type": ["number", "null"] },
                  "memory_rss_bytes": { "type": ["integer", "null"] },
                  "event_queue_max": { "type": ["integer", "null"] },
                  "scheduler_lag_p99_ms": { "type": ["number", "null"] },
                  "restarts": { "type": ["integer", "null"], "minimum": 0 }
                }
              }
            }
          }
        },
        "engine_bot_backend_details": {
          "allOf": [{ "$ref": "#/$defs/section_base" }],
          "properties": {
            "adapters": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["adapter_name"],
                "properties": {
                  "adapter_name": { "type": "string", "minLength": 1 },
                  "scheduling_resolution_ms": { "type": ["integer", "null"] },
                  "bot_count_total": { "type": ["integer", "null"] },
                  "bot_count_connected": { "type": ["integer", "null"] },
                  "bot_count_logged_in": { "type": ["integer", "null"] },
                  "capabilities_note": { "type": "string" }
                }
              }
            }
          }
        },
        "server_performance": {
          "allOf": [{ "$ref": "#/$defs/section_base" }],
          "properties": {
            "metrics": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["metric", "unit"],
                "properties": {
                  "metric": { "type": "string", "minLength": 1 },
                  "unit": { "type": "string", "minLength": 1 },
                  "coverage_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
                }
              }
            }
          }
        },
        "correlation_analysis": {
          "allOf": [{ "$ref": "#/$defs/section_base" }],
          "properties": {
            "claims": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["metric_a", "metric_b", "asserts_causality"],
                "properties": {
                  "metric_a": { "type": "string", "minLength": 1 },
                  "metric_b": { "type": "string", "minLength": 1 },
                  "asserts_causality": {
                    "const": false,
                    "$comment": "Plan 13.3: correlation is never causation; a report may not assert causality."
                  },
                  "coefficient": { "type": ["number", "null"] }
                }
              }
            }
          }
        },
        "bottleneck_analysis": {
          "allOf": [{ "$ref": "#/$defs/section_base" }],
          "properties": {
            "claims": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["resource", "statement", "single_metric_inference", "evidence"],
                "properties": {
                  "resource": { "type": "string", "minLength": 1 },
                  "statement": { "type": "string", "minLength": 1 },
                  "single_metric_inference": {
                    "const": false,
                    "$comment": "Plan 13.3: high CPU alone never proves CPU is the only bottleneck."
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["section", "quality"],
                      "properties": {
                        "section": {
                          "enum": [
                            "client_performance",
                            "generator_health",
                            "server_performance",
                            "planned_vs_actual_arrival",
                            "concurrency_curve"
                          ]
                        },
                        "quality": { "$ref": "#/$defs/data_quality" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "data_quality": {
          "allOf": [{ "$ref": "#/$defs/section_base" }],
          "properties": {
            "labels_summary": {
              "type": "object",
              "description": "Counts of series/sections per label; missing data must not be filled with zeros (plan 11.3).",
              "properties": {
                "Complete": { "type": "integer", "minimum": 0 },
                "Partial": { "type": "integer", "minimum": 0 },
                "Delayed": { "type": "integer", "minimum": 0 },
                "Missing": { "type": "integer", "minimum": 0 },
                "Estimated": { "type": "integer", "minimum": 0 },
                "Invalid": { "type": "integer", "minimum": 0 },
                "GeneratorSaturated": { "type": "integer", "minimum": 0 },
                "ObserverDegraded": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "test_validity": {
          "allOf": [{ "$ref": "#/$defs/section_base" }],
          "required": ["verdict"],
          "properties": {
            "verdict": { "enum": ["Valid", "Invalid", "Partial"] },
            "failed_criteria": { "type": "array", "items": { "type": "string" } }
          }
        },
        "environment": {
          "allOf": [{ "$ref": "#/$defs/section_base" }],
          "properties": {
            "versions": { "type": "object" },
            "configuration_digest": { "type": ["string", "null"], "description": "plan_digest of the frozen ShardPlan" }
          }
        },
        "raw_data_references": {
          "allOf": [{ "$ref": "#/$defs/section_base" }],
          "properties": {
            "artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "format"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "format": { "enum": ["parquet", "json", "hdr-blob-v2", "log", "evidence-bundle", "other"] }
                }
              }
            }
          }
        },
        "assertions": {
          "description": "ADR-007 optional §15: business-semantics assertion results delivered by external Assertion Providers. Wavemaker only schedules and records; it is never the oracle. Optional so pre-ADR-007 reports remain valid.",
          "allOf": [{ "$ref": "#/$defs/section_base" }],
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["provider", "name", "status", "checked_at", "evidence"],
                "properties": {
                  "provider": { "type": "string", "minLength": 1 },
                  "name": { "type": "string", "minLength": 1 },
                  "status": {
                    "enum": ["pass", "fail", "inconclusive"],
                    "$comment": "inconclusive covers provider timeout/unavailable/partial coverage; a missing provider result must be recorded as inconclusive, never rendered as pass."
                  },
                  "checked_at": { "type": "string", "format": "date-time" },
                  "window": {
                    "type": "object",
                    "properties": {
                      "start": { "type": "string", "format": "date-time" },
                      "end": { "type": "string", "format": "date-time" }
                    }
                  },
                  "trigger": {
                    "enum": ["after_scenario", "after_recovery", "periodic", "other"],
                    "description": "Execution window that produced this result (assertion-provider.md §4)."
                  },
                  "message": { "type": "string" },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["kind", "ref"],
                      "properties": {
                        "kind": { "enum": ["artifact", "query", "other"] },
                        "ref": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "conclusions": {
      "type": "object",
      "required": ["confidence"],
      "properties": {
        "confidence": { "enum": ["high", "medium", "low"] },
        "capacity_conclusion": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["statement", "based_on"],
              "properties": {
                "statement": { "type": "string", "minLength": 1 },
                "based_on": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "enum": ["Basin", "Actual", "Planned"] },
                  "$comment": "Generator-derived values are excluded: plan 13.3 forbids client latency substituting for server metrics."
                },
                "concurrency_level": { "type": ["integer", "null"] }
              }
            }
          ]
        },
        "bottleneck_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["resource", "asserts_causality"],
            "properties": {
              "resource": { "type": "string", "minLength": 1 },
              "asserts_causality": { "const": false },
              "statement": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
